{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "رفع جميع الملفات إلى GitHub",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\publish-safe-to-github.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": false
      },
      "runOptions": {
        "reevaluateOnRerun": true
      }
    }
  ]
}
